# GitHub 采集必填
GITHUB_TOKEN=github_pat_xxx
# 可选：仅在 repositories 表为空时由 init-db 首次导入
# 初始化后请使用 python pipeline.py repo ... 管理白名单
GITHUB_REPOSITORIES=rust-lang/rust,tokio-rs/tokio
# 数据库必填
DATABASE_URL=mysql+pymysql://github_sentiment:change-me@127.0.0.1:3306/github_sentiment?charset=utf8mb4

# 默认使用智谱 BigModel 国内标准 API；填写对应平台的 API Key
LLM_PROVIDER=glm
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3-flash
# GLM-5.3 Flash 不能关闭思考；可选 low / high / max
GLM_REASONING_EFFORT=low
# 为思考及最终 JSON 预留输出空间；截断时记为失败，不写入成功标签
GLM_MAX_TOKENS=8192
GLM_TIMEOUT_SECONDS=180

# 可选：回切 DeepSeek 时设置 LLM_PROVIDER=deepseek，并填写以下密钥
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 仅 DeepSeek 使用；GLM 不发送此参数
DEEPSEEK_USER_ID=rust-sentiment-labeler

# 可选
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_CURSOR_OVERLAP_SECONDS=300
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=5
# 每条语料使用一个独立请求；并发只控制同时在途的请求数；硬上限 500
LLM_CONCURRENCY=20
# 每次标注进程先串行发送少量请求，验证鉴权并给公共 SYSTEM 前缀建立缓存；即使设为 0 也会安全预检 1 条
LLM_CACHE_WARMUP_REQUESTS=2
# 非致命单条错误连续达到该数量时停止整个任务；401/403 等全局错误不等待阈值、立即停止
LLM_MAX_CONSECUTIVE_FAILURES=10
# 数据库读取与写入按批次处理，不改变“一条语料一个 LLM 请求”的隔离语义
LABEL_FETCH_SIZE=200
ANNOTATION_WRITE_BATCH_SIZE=50
LOG_LEVEL=INFO
